# Copiá este archivo como ".env" y completá con tus datos reales.
# El .env real NUNCA se sube a GitHub (ya está en .gitignore).

PORT=3000

# Conexión a MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=la_huella

# Frase secreta para firmar la sesión (poné cualquier texto largo y random)
SESSION_SECRET=cambiar-esto-por-un-texto-secreto-largo

# URL del frontend, para permitir cookies entre dominios (CORS)
FRONTEND_ORIGIN=http://localhost:5500

# Cuenta de administrador que crea "npm run init"
ADMIN_EMAIL=admin@lahuella.com
ADMIN_PASSWORD=cambiar-esta-contraseña
